                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "2018-01-01"
                }
              ],
              "variable": [
                {
                  "description": "Topic or domain endpoint host",
                  "type": "any",
                  "value": "{{topic-endpoint}}",
                  "key": "topic-endpoint"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
