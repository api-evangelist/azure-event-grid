  "info": {
    "_postman_id": "4026fe2a-2a6c-4a85-9714-524ac55b96a9",
    "name": "Azure Event Grid Publisher Namespace Topics Publish API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Data-plane REST API for publishing events to Azure Event Grid topics, domains,\nand namespace topics. Supports the Event Grid event schema, the CloudEvents 1.0\nschema, and custom schemas. Authentication is via Microsoft Entra ID OAuth 2.0\nbearer tokens or the topic's shared-access key sent in the `aeg-sas-key` header\n(or a SAS token in the `aeg-sas-token` header).\n\n\nContact Support:\n Name: Azure Event Grid",
      "type": "text/plain"
    }
  }
