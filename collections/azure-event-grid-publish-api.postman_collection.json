                  "value": "aeg-sas-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"<string>\",\n    \"subject\": \"<string>\",\n    \"data\": \"\",\n    \"eventType\": \"<string>\",\n    \"eventTime\": \"<dateTime>\",\n    \"dataVersion\": \"<string>\",\n    \"topic\": \"<string>\",\n    \"metadataVersion\": \"<string>\"\n  },\n  {\n    \"id\": \"<string>\",\n    \"subject\": \"<string>\",\n    \"data\": \"\",\n    \"eventType\": \"<string>\",\n    \"eventTime\": \"<dateTime>\",\n    \"dataVersion\": \"<string>\",\n    \"topic\": \"<string>\",\n    \"metadataVersion\": \"<string>\"\n  }\n]",
